{
    "compilerOptions": {
        "target": "es6",
        "module": "es6",
        "outDir": "./public/js/",
        "rootDir": "./src",
        "esModuleInterop": true,
        "moduleResolution": "node",
        "paths": {
            "undici-types": ["./node_modules/undici-types/index.d.ts"]
        },
        "strict": false,
        "forceConsistentCasingInFileNames": true,
        "strictNullChecks": true,
        "resolveJsonModule": true
    },
    "exclude": [
        "node_module"
    ],
    "include": [
        "src/**/*"
    ]
}