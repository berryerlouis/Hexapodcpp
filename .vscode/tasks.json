{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build X64 Debug",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "linux": {
                "command": "bash",
                "args": [
                    "bin/dev/build.sh",
                    "X64",
                    "sources",
                    "DEBUG"
                ]
            },
            "windows": {
                "command": "wsl",
                "args": [
                    "bash",
                    "bin/dev/build.sh",
                    "X64",
                    "sources",
                    "${input:buildType}"
                ]
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false,
                "revealProblems": "onProblem"
            }
        },
        {
            "label": "Build X64",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "linux": {
                "command": "bash",
                "args": [
                    "bin/dev/build.sh",
                    "X64",
                    "sources",
                    "${input:buildType}"
                ]
            },
            "windows": {
                "command": "wsl",
                "args": [
                    "bash",
                    "bin/dev/build.sh",
                    "X64",
                    "sources",
                    "${input:buildType}"
                ]
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false,
                "revealProblems": "onProblem"
            }
        },
        {
            "label": "Test X64",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "linux": {
                "command": "bash",
                "args": [
                    "bin/dev/test.sh",
                    "${input:makeTarget}"
                ]
            },
            "windows": {
                "command": "wsl",
                "args": [
                    "bash",
                    "bin/dev/test.sh",
                    "${input:makeTarget}"
                ]
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false,
                "revealProblems": "onProblem"
            }
        },
        {
            "label": "Build RPI (Docker Cross-Compile)",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "linux": {
                "command": "bash",
                "args": [
                    "bin/dev/docker-build-rpi.sh",
                    "${input:buildType}"
                ]
            },
            "windows": {
                "command": "wsl",
                "args": [
                    "bash",
                    "bin/dev/docker-build-rpi.sh",
                    "${input:buildType}"
                ]
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false,
                "revealProblems": "onProblem"
            }
        },
        {
            "label": "Deploy to RPi",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "linux": {
                "command": "scp",
                "args": [
                    "Hexapodcpp",
                    "hexabot:/home/hexabot/"
                ]
            },
            "windows": {
                "command": "wsl",
                "args": [
                    "scp",
                    "Hexapodcpp",
                    "hexabot:/home/hexabot/"
                ]
            },
            "problemMatcher": []
        },
        {
            "label": "Run RPi",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "linux": {
                "command": "ssh",
                "args": [
                    "hexabot",
                    "sudo systemctl start hexabot.service"
                ]
            },
            "windows": {
                "command": "wsl",
                "args": [
                    "ssh",
                    "hexabot",
                    "sudo systemctl start hexabot.service"
                ]
            },
            "problemMatcher": []
        },
        {
            "label": "Start GDB Server on RPi",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "linux": {
                "command": "ssh",
                "args": [
                    "hexabot",
                    "command -v gdbserver >/dev/null || sudo apt-get install -y gdbserver; pkill gdbserver 2>/dev/null || true; gdbserver :2345 /home/hexabot/Hexapodcpp"
                ]
            },
            "windows": {
                "command": "wsl",
                "args": [
                    "ssh",
                    "hexabot",
                    "command -v gdbserver >/dev/null || sudo apt-get install -y gdbserver; pkill gdbserver 2>/dev/null || true; gdbserver :2345 /home/hexabot/Hexapodcpp"
                ]
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "."
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Listening on port 2345"
                }
            }
        },
        {
            "label": "Build & Deploy to RPi",
            "dependsOn": [
                "Build RPI (Docker Cross-Compile)",
                "Deploy to RPi",
                "Run RPi"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Build, Deploy & Debug RPi",
            "dependsOn": [
                "Build RPI (Docker Cross-Compile)",
                "Deploy to RPi",
                "Start GDB Server on RPi"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Debug RPi (Interactive GDB)",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "pwsh.exe",
            "args": [
                "-NoExit",
                "-File",
                ".vscode/debug-rpi.ps1"
            ],
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": true
            },
            "dependsOn": "Start GDB Server on RPi"
        }
    ],
    "inputs": [
        {
            "type": "pickString",
            "id": "makeTarget",
            "description": "Which test to run ?",
            "options": [
                "all",
                "clean",
                "help",
                "UT_BOT_BODY",
                "UT_BOT_LEG",
                "UT_BOT_LEGS",
                "UT_CLU_BATTERY",
                "UT_CLU_BODY",
                "UT_CLU_BUTTON",
                "UT_CLU_FRAME",
                "UT_CLU_GENERAL",
                "UT_CLU_IMU",
                "UT_CLU_PROTOCOL",
                "UT_CLU_PROXIMITY",
                "UT_CLU_SERVO",
                "UT_CLU_SOUND",
                "UT_CMP_ADS1115",
                "UT_CMP_AHRS",
                "UT_CMP_BATTERY",
                "UT_CMP_BUTTON",
                "UT_CMP_COMMUNICATION",
                "UT_CMP_LED",
                "UT_CMP_MPU9150",
                "UT_CMP_PCA9685",
                "UT_CMP_PROXIMITY",
                "UT_CMP_SERVO",
                "UT_CMP_SERVOS",
                "UT_CMP_SOUND",
                "UT_CMP_SRF05",
                "UT_CMP_VL53L0X",
                "UT_SRV_BATTERY",
                "UT_SRV_BUTTON",
                "UT_SRV_COMMUNICATION",
                "UT_SRV_CONTROL",
                "UT_SRV_DISPLAY",
                "UT_SRV_GENERAL",
                "UT_SRV_ORIENTATION",
                "UT_SRV_PROXIMITY",
                "UT_SRV_SOUND"
            ],
            "default": "all"
        },
        {
            "type": "pickString",
            "id": "buildType",
            "description": "Which build type?",
            "options": [
                "DEBUG",
                "RELEASE",
                "CLEAN"
            ],
            "default": "DEBUG"
        }
    ]
}