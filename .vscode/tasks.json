{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Prod Build",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "linux": {
                "command": "bash",
                "args": [
                    "bin/prod/build.sh"
                ]
            },
            "windows": {
                "command": "wsl",
                "args": [
                    "bash",
                    "bin/prod/build.sh"
                ]
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build X64 Debug",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "linux": {
                "command": "bash",
                "args": [
                    "bin/dev/build.sh",
                    "X64",
                    "sources",
                    "DEBUG"
                ]
            },
            "windows": {
                "command": "wsl",
                "args": [
                    "bash",
                    "bin/dev/build.sh",
                    "X64",
                    "sources",
                    "DEBUG"
                ]
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build X64",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "linux": {
                "command": "bash",
                "args": [
                    "bin/dev/build.sh",
                    "X64",
                    "sources",
                    "${input:buildType}"
                ]
            },
            "windows": {
                "command": "wsl",
                "args": [
                    "bash",
                    "bin/dev/build.sh",
                    "X64",
                    "sources",
                    "${input:buildType}"
                ]
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Test X64",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "linux": {
                "command": "bash",
                "args": [
                    "bin/dev/test.sh",
                    "${input:makeTarget}"
                ]
            },
            "windows": {
                "command": "wsl",
                "args": [
                    "bash",
                    "bin/dev/test.sh",
                    "${input:makeTarget}"
                ]
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Coverage",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "linux": {
                "command": "bash",
                "args": [
                    "bin/dev/coverage.sh"
                ]
            },
            "windows": {
                "command": "wsl",
                "args": [
                    "bash",
                    "bin/dev/coverage.sh"
                ]
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Cppcheck",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "linux": {
                "command": "bash",
                "args": [
                    "bin/dev/cppcheck.sh"
                ]
            },
            "windows": {
                "command": "wsl",
                "args": [
                    "bash",
                    "bin/dev/cppcheck.sh"
                ]
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build RPI (Docker Cross-Compile)",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "linux": {
                "command": "bash",
                "args": [
                    "bin/dev/docker-build-rpi.sh",
                    "${input:buildType}"
                ]
            },
            "windows": {
                "command": "wsl",
                "args": [
                    "bash",
                    "bin/dev/docker-build-rpi.sh",
                    "${input:buildType}"
                ]
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Reformat all",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "linux": {
                "command": "bash",
                "args": [
                    "bin/dev/clang-format-all.sh"
                ]
            },
            "windows": {
                "command": "wsl",
                "args": [
                    "bash",
                    "bin/dev/clang-format-all.sh"
                ]
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Static Anlysis",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "linux": {
                "command": "bash",
                "args": [
                    "bin/dev/clang-tidy.sh"
                ]
            },
            "windows": {
                "command": "wsl",
                "args": [
                    "bash",
                    "bin/dev/clang-tidy.sh"
                ]
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build RPI Debug (Docker Cross-Compile)",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "linux": {
                "command": "bash",
                "args": [
                    "bin/dev/docker-build-rpi.sh",
                    "DEBUG"
                ]
            },
            "windows": {
                "command": "wsl",
                "args": [
                    "bash",
                    "bin/dev/docker-build-rpi.sh",
                    "DEBUG"
                ]
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Deploy to RPi",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "linux": {
                "command": "bash",
                "args": [
                    "bin/dev/deploy-to-rpi.sh"
                ]
            },
            "windows": {
                "command": "wsl",
                "args": [
                    "bash",
                    "bin/dev/deploy-to-rpi.sh"
                ]
            }
        },
        {
            "label": "Run RPi",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "linux": {
                "command": "bash",
                "args": [
                    "bin/dev/run-rpi.sh"
                ]
            },
            "windows": {
                "command": "wsl",
                "args": [
                    "bash",
                    "bin/dev/run-rpi.sh"
                ]
            }
        },
        {
            "label": "Start GDB Server on RPi",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "linux": {
                "command": "bash",
                "args": [
                    "bin/dev/start-gdb-rpi.sh"
                ]
            },
            "windows": {
                "command": "wsl",
                "args": [
                    "bash",
                    "bin/dev/start-gdb-rpi.sh"
                ]
            },
            "isBackground": true
        },
        {
            "label": "Build & Deploy to RPi",
            "dependsOn": [
                "Build RPI (Docker Cross-Compile)",
                "Deploy to RPi",
                "Run RPi"
            ],
            "dependsOrder": "sequence"
        },
        {
            "label": "Build, Deploy & Debug RPi",
            "dependsOn": [
                "Build RPI Debug (Docker Cross-Compile)",
                "Deploy to RPi",
                "Start GDB Server on RPi"
            ],
            "dependsOrder": "sequence"
        }
    ],
    "inputs": [
        {
            "type": "pickString",
            "id": "makeTarget",
            "description": "Which test to run ?",
            "options": [
                "all",
                "clean",
                "help",
                "UT_BOT_BODY",
                "UT_CLU_BATTERY",
                "UT_CLU_BODY",
                "UT_CLU_BUTTON",
                "UT_CMP_FRAME",
                "UT_CLU_GENERAL",
                "UT_CLU_IMU",
                "UT_CMP_PROTOCOL",
                "UT_CLU_PROXIMITY",
                "UT_CLU_SERVO",
                "UT_CLU_SOUND",
                "UT_CMP_ADS1115",
                "UT_CMP_AHRS",
                "UT_CMP_BATTERY",
                "UT_CMP_BUTTON",
                "UT_CMP_COMMUNICATION",
                "UT_CMP_LED",
                "UT_CMP_MPU9150",
                "UT_CMP_PCA9685",
                "UT_CMP_PROXIMITY",
                "UT_CMP_SERVO",
                "UT_CMP_SERVOS",
                "UT_CMP_SOUND",
                "UT_CMP_SRF05",
                "UT_CMP_VL53L0X",
                "UT_SRV_BATTERY",
                "UT_SRV_BODY",
                "UT_SRV_BUTTON",
                "UT_SRV_COMMUNICATION",
                "UT_SRV_CONTROL",
                "UT_SRV_DISPLAY",
                "UT_SRV_GENERAL",
                "UT_SRV_ORIENTATION",
                "UT_SRV_PROXIMITY",
                "UT_SRV_SOUND",
                "UT_MOVE_GAIT_CYCLE",
                "UT_MOVE_GAIT_PARAMS",
                "UT_COR_STATUS",
                "UT_COR_LOGGER"
            ],
            "default": "all"
        },
        {
            "type": "pickString",
            "id": "buildType",
            "description": "Which build type?",
            "options": [
                "DEBUG",
                "RELEASE",
                "CLEAN"
            ],
            "default": "DEBUG"
        }
    ]
}