FROM debian:trixie-slim AS toolchain

ENV DEBIAN_FRONTEND=noninteractive

RUN dpkg --add-architecture arm64 \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    build-essential cmake git ca-certificates pkg-config file curl wget sudo \
    gcc-aarch64-linux-gnu g++-aarch64-linux-gnu \
    libssl-dev:arm64 libssl3t64:arm64 zlib1g-dev:arm64 \
    && rm -rf /var/lib/apt/lists/*

# Explicitly point cmake find modules to aarch64 multiarch paths (avoid host x86_64 picks)
ENV PKG_CONFIG_LIBDIR=/usr/lib/aarch64-linux-gnu/pkgconfig

# Allow working with mounted volumes that have "dubious ownership"
RUN git config --global --add safe.directory '*'

# (Optional) Corp CA certificates pattern retained from existing Dockerfiles; harmless if URLs invalid
RUN mkdir -p /usr/local/share/ca-certificates/ZScaler \
    && wget -O /usr/local/share/ca-certificates/ZScaler/ZscalerRootCA.crt https://raw.github.schneider-electric.com/swag-doc/swag-proxy/refs/heads/main/ZscalerRootCA.crt \
    && wget -O /usr/local/share/ca-certificates/ZScaler/cacert_certifi_zscaler.crt https://raw.github.schneider-electric.com/swag-doc/swag-proxy/refs/heads/main/cacert_certifi_zscaler.crt \
    && update-ca-certificates

# Fetch WiringPi and install headers + shared lib for cross-link (uses aarch64 toolchain)
WORKDIR /tmp
RUN git clone --depth=1 https://github.com/WiringPi/WiringPi wiringpi-src \
    && cd wiringpi-src/wiringPi \
    && export CC=aarch64-linux-gnu-gcc CXX=aarch64-linux-gnu-g++ AR=aarch64-linux-gnu-ar RANLIB=aarch64-linux-gnu-ranlib STRIP=aarch64-linux-gnu-strip \
    && make -j"$(nproc)" || true \
    && install -d /usr/aarch64-linux-gnu/lib /usr/aarch64-linux-gnu/include \
    && install -m 0644 *.h /usr/aarch64-linux-gnu/include/ || true \
    && install -m 0755 libwiringPi.so* /usr/aarch64-linux-gnu/lib/ || true \
    && ldconfig \
    && (ls -1 /usr/aarch64-linux-gnu/lib/libwiringPi.so* | grep -q "libwiringPi.so$" || { \
    sofile=$(ls -1 /usr/aarch64-linux-gnu/lib/libwiringPi.so.* | head -n1); \
    ln -sf "$(basename "$sofile")" /usr/aarch64-linux-gnu/lib/libwiringPi.so; echo "Created symlink libwiringPi.so -> $(basename "$sofile")"; }) \
    && echo "WiringPi cross build complete"

# Fetch TinyWebsockets
RUN git clone --depth=1 https://github.com/berryerlouis/TinyWebsockets.git /tmp/tinywebsockets \
    && echo "TinyWebsockets cached for FetchContent"

# Pre-populate FetchContent cache to avoid network access during CMake
ENV FETCHCONTENT_SOURCE_DIR_WIRINGPI=/tmp/wiringpi-src
ENV FETCHCONTENT_SOURCE_DIR_TINYWEBSOCKETS=/tmp/tinywebsockets


# Final build stage (copies sources for reproducible build)
FROM toolchain AS build
WORKDIR /workspace
COPY . .


RUN echo "== OpenSSL preflight ==" \
    && echo "Listing OpenSSL libraries:" \
    && ls -l /usr/lib/aarch64-linux-gnu/libssl* /usr/lib/aarch64-linux-gnu/libcrypto* || true \
    && echo "Creating symlinks if needed:" \
    && if [ ! -f /usr/aarch64-linux-gnu/lib/libssl.so ]; then \
    mkdir -p /usr/aarch64-linux-gnu/lib && \
    ln -sf /usr/lib/aarch64-linux-gnu/libssl.so.3 /usr/aarch64-linux-gnu/lib/libssl.so && \
    ln -sf /usr/lib/aarch64-linux-gnu/libcrypto.so.3 /usr/aarch64-linux-gnu/lib/libcrypto.so && \
    echo "Created OpenSSL symlinks in /usr/aarch64-linux-gnu/lib"; \
    fi \
    && ls -l /usr/aarch64-linux-gnu/lib/libssl* /usr/aarch64-linux-gnu/lib/libcrypto* \
    && test -f /usr/include/openssl/ssl.h && echo "Found headers at /usr/include/openssl" 
#    && cmake -Wno-dev -S . -B build/rpi-release \
#    -DCMAKE_TOOLCHAIN_FILE=/workspace/cmake/toolchain-rpi-zero-2-w.cmake \
#    -DCMAKE_BUILD_TYPE=Release \
#    -DTARGET=RPI \
#    -DOPENSSL_USE_STATIC_LIBS=OFF \
#    && cmake --build build/rpi-release --target Hexapodcpp -- -j"$(nproc)"



# Keep container alive for optional inspection; binary at /workspace/build/rpi-release/src/Hexapodcpp
CMD ["/bin/bash"]
